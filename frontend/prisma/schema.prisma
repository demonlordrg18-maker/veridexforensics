// Veridex Forensics — Prisma Database Schema
// Digital Trust Operating System Data Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTHENTICATION MODELS
// ==========================================

enum UserRole {
  GUEST
  FREE
  STUDENT
  RESEARCHER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  ADMINISTRATOR
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
  ACADEMIC
}

model User {
  id                    String             @id @default(cuid())
  name                  String?
  email                 String             @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  role                  UserRole           @default(FREE)
  subscriptionTier      SubscriptionTier   @default(FREE)
  referralCode          String             @unique @default(cuid())
  referredByCode        String?
  organizationId        String?
  createdDate           DateTime           @default(now())
  lastLogin             DateTime           @default(now())
  
  // JSON Preferences & Notifications
  preferences           Json?              @default("{\"theme\":\"dark\",\"defaultModality\":\"text\",\"autoExportPdf\":false}")
  notificationSettings  Json?              @default("{\"emailAlerts\":true,\"creditWarnings\":true,\"weeklyReport\":false}")
  onboardingCompleted   Boolean            @default(false)
  useCase               String?            // Journalist, HR, University, Research, Law, Enterprise

  // Relationships
  accounts              Account[]
  sessions              Session[]
  organization          Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creditBalance         CreditBalance?
  creditTransactions    CreditTransaction[]
  cases                 Case[]
  evidenceItems         Evidence[]
  reports               Report[]
  apiKeys               APIKey[]
  activityLogs          ActivityLog[]
  subscriptions         Subscription[]
  invoices              Invoice[]
  payments              Payment[]
  aiConversations       AIConversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// CREDIT ECONOMY MODELS
// ==========================================

model CreditBalance {
  id                String   @id @default(cuid())
  userId            String   @unique
  monthlyAllocation Int      @default(50)
  creditsRemaining  Int      @default(50)
  creditsUsed       Int      @default(0)
  bonusCredits      Int      @default(0)
  lastResetDate     DateTime @default(now())
  nextResetDate     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  action       String   // TEXT_AUDIT, IMAGE_FORENSIC, PDF_SCAN, AUDIO_AUDIT, VIDEO_VERIFY, URL_AUDIT, METADATA_SCAN, REPLENISHMENT, PURCHASE
  creditsUsed  Int
  remaining    Int
  timestamp    DateTime @default(now())
  caseId       String?
  reportId     String?
  ipAddress    String?
  deviceInfo   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditRateCard {
  id          String   @id @default(cuid())
  modality    String   @unique // text, image, pdf, audio, video, link, metadata
  creditCost  Int
  description String
  updatedAt   DateTime @updatedAt
}

// ==========================================
// ENTERPRISE & ORGANIZATION MODELS
// ==========================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  ssoEnabled  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     User[]
  departments Department[]
  cases       Case[]
  apiKeys     APIKey[]
}

model Department {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==========================================
// FORENSIC DATA MODELS (CASES, EVIDENCE, REPORTS)
// ==========================================

model Case {
  id             String        @id @default(cuid())
  caseNumber     String        @unique
  title          String
  description    String?
  status         String        @default("OPEN") // OPEN, IN_PROGRESS, WAITING, COMPLETED, ARCHIVED, CUSTOM
  priority       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  category       String        @default("RESEARCH") // OSINT, ACADEMIC, HR, LEGAL, MEDIA, GOVERNMENT, RESEARCH, ENTERPRISE, CUSTOM
  visibility     String        @default("PRIVATE") // PRIVATE, TEAM, ORGANIZATION
  dueDate        DateTime?
  tags           String[]      @default([])
  userId         String
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  evidence     Evidence[]
  reports      Report[]
  members      CaseMember[]
  activities   CaseActivity[]
  notes        CaseNote[]
  comments     CaseComment[]
  pinnedItems  PinnedItem[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([organizationId])
}

model Evidence {
  id              String   @id @default(cuid())
  title           String
  modality        String   // text, image, audio, video, pdf, url, document, screenshot, archive
  fileHash        String   // SHA-256 cryptographic hash
  storageUrl      String?
  fileSizeBytes   Int?
  caseId          String?
  userId          String
  analysisStatus  String   @default("PENDING") // PENDING, ANALYZING, COMPLETED, FAILED
  confidence      Float?
  status          String   @default("ACTIVE") // ACTIVE, ARCHIVED
  favorite        Boolean  @default(false)
  version         Int      @default(1)
  creditsUsed     Int      @default(0)
  notes           String?  @db.Text
  customMetadata  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  reports   Report[]
  tags      EvidenceTag[]
  metadata  EvidenceMetadata?
  versions  EvidenceVersion[]

  @@index([userId, caseId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([fileHash])
}

model EvidenceTag {
  id         String   @id @default(cuid())
  evidenceId String
  tag        String
  createdAt  DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, tag])
  @@index([tag])
}

model EvidenceMetadata {
  id              String   @id @default(cuid())
  evidenceId      String   @unique
  uploaderName    String?
  mimeType        String?
  originalFilename String?
  storageLocation String?
  analysisHistory Json?    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}

model EvidenceVersion {
  id            String   @id @default(cuid())
  evidenceId    String
  versionNumber Int
  fileHash      String
  storageUrl    String?
  fileSizeBytes Int?
  changeNotes   String?
  createdAt     DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, versionNumber])
  @@index([evidenceId])
}

model CaseMember {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  role      String   @default("VIEWER") // OWNER, EDITOR, VIEWER, GUEST
  invitedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
}

model CaseActivity {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  action    String   // EVIDENCE_ADDED, ANALYSIS_COMPLETED, REPORT_GENERATED, COMMENT, STATUS_CHANGE, EXPORT, NOTE_EDIT
  details   Json?
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseComment {
  id         String    @id @default(cuid())
  caseId     String
  userId     String
  userName   String
  content    String    @db.Text
  parentId   String?
  resolved   Boolean   @default(false)
  reactions  Json?     @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model PinnedItem {
  id         String   @id @default(cuid())
  userId     String
  itemType   String   // CASE, EVIDENCE, REPORT
  itemId     String
  caseId     String?
  pinnedAt   DateTime @default(now())

  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
}

model WorkspaceStorage {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalBytes      BigInt   @default(0)
  evidenceCount   Int      @default(0)
  caseCount       Int      @default(0)
  reportCount     Int      @default(0)
  lastCalculated  DateTime @default(now())

  @@index([userId])
}

model Report {
  id           String   @id @default(cuid())
  title        String
  verityIndex  Float
  truthScore   Float
  confidence   Float
  origin       String   // ai, human, hybrid
  findings     Json     // Array of evidence findings
  biasReport   Json?
  factuality   Json?
  spectral     Json?
  evidenceId   String?
  caseId       String?
  userId       String
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  case     Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
}

// ==========================================
// BILLING, API KEYS & SECURITY AUDIT LOGS
// ==========================================

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  status               String   // active, canceled, past_due, trialing
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model APIKey {
  id             String        @id @default(cuid())
  keyHash        String        @unique
  prefix         String
  name           String
  userId         String
  organizationId String?
  rateLimit      Int           @default(1000)
  createdAt      DateTime      @default(now())
  lastUsed       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // UPLOAD, ANALYSIS, REPORT, EXPORT, CASE_CREATE, CASE_UPDATE, CREDIT_PURCHASE
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  userId         String
  amount         Float
  currency       String   @default("USD")
  status         String   // paid, open, void, uncollectible
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  billingAddress Json?
  taxId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  invoiceId     String?
  amount        Float
  currency      String   @default("USD")
  status        String   // succeeded, pending, failed
  paymentMethod String   // card, bank_transfer, upi, other
  provider      String   // stripe, wire, mock
  providerTxId  String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountType   String   // percentage, fixed_amount
  discountValue  Float
  active         Boolean  @default(true)
  expiresAt      DateTime?
  maxRedemptions Int?
  redemptions    Int      @default(0)
  createdAt      DateTime @default(now())
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referredId    String   @unique
  rewardPaid    Boolean  @default(false)
  creditsEarned Int      @default(25)
  createdAt     DateTime @default(now())
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  userId       String?
  orgId        String?
  eventType    String   // credit_usage, storage_upload, api_call, login, report_generated
  modality     String?  // text, image, audio, video, document, link, metadata
  creditsUsed  Int      @default(0)
  storageBytes Int      @default(0)
  details      Json?
  timestamp    DateTime @default(now())

  @@index([userId, timestamp])
  @@index([orgId, timestamp])
  @@index([eventType])
}

model UsageMetric {
  id             String   @id @default(cuid())
  userId         String
  metricName     String   // credits_remaining, storage_used_bytes, cases_count
  value          Float
  timestamp      DateTime @default(now())

  @@index([userId, metricName, timestamp])
}

model CustomDashboard {
  id          String   @id @default(cuid())
  userId      String
  name        String
  layout      Json     // Widgets layout & query configuration
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  category    String   // guide, methodology, tutorial, release_note, security
  tags        String[] @default([])
  published   Boolean  @default(true)
  authorName  String   @default("Veridex Core Team")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model DiscussionThread {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  category    String   // question, announcement, methodology, general
  tags        String[] @default([])
  userId      String
  userName    String
  userAvatar  String?
  upvotes     Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments    DiscussionComment[]
  bookmarks   DiscussionBookmark[]

  @@index([category])
  @@index([userId])
}

model DiscussionComment {
  id          String   @id @default(cuid())
  threadId    String
  userId      String
  userName    String
  userAvatar  String?
  content     String   @db.Text
  parentId    String?
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thread      DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model DiscussionBookmark {
  id          String   @id @default(cuid())
  threadId    String
  userId      String
  createdAt   DateTime @default(now())

  thread      DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

model InvestigationTemplate {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  config         Json     // Analysis workflow settings, rate configurations
  isPublic       Boolean  @default(false)
  downloads      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, isPublic])
}

model MarketplaceListing {
  id             String   @id @default(cuid())
  name           String
  description    String
  category       String   // template, pipeline, plugin, extension, theme
  pricingModel   String   // free, dynamic_credits, commercial
  priceCredits   Int      @default(0)
  authorName     String
  authorId       String
  configTemplate Json?
  downloads      Int      @default(0)
  rating         Float    @default(5.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

model IntegrationSetting {
  id             String   @id @default(cuid())
  userId         String
  orgId          String?
  provider       String   // slack, msteams, gdrive, dropbox, github, jira, zapier, webhook
  enabled        Boolean  @default(false)
  config         Json     // OAuth tokens, webhook urls, specific folders
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// ==========================================
// PHASE 14 & 15: AI ASSISTANT & GLOBAL PLATFORM
// ==========================================

model AIConversation {
  id             String        @id @default(cuid())
  title          String
  userId         String
  pinned         Boolean       @default(false)
  contextType    String?       // CASE, EVIDENCE, REPORT, GENERAL
  contextId      String?       // Reference ID of the active context
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String         // user, assistant, system
  content        String         @db.Text
  contextUsed    Json?          // Snapshot of Case/Evidence metadata attached
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AIPromptTemplate {
  id             String         @id @default(cuid())
  userId         String?        // null for system-wide templates
  name           String
  description    String?
  promptText     String         @db.Text
  category       String         // summarization, timeline, triage, reporting
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model AutomationWorkflow {
  id             String         @id @default(cuid())
  userId         String
  orgId          String?
  name           String
  triggerType    String         // EVIDENCE_UPLOADED, CASE_CREATED, STATUS_CHANGED
  actions        Json           // Ordered actions array: e.g., [{"type":"analyze"},{"type":"notify"}]
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  runs           WorkflowRun[]
}

model WorkflowRun {
  id             String             @id @default(cuid())
  workflowId     String
  status         String             // PENDING, RUNNING, COMPLETED, FAILED
  triggerData    Json
  logs           Json?              // Output execution steps
  startedAt      DateTime           @default(now())
  completedAt    DateTime?

  workflow       AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id             String         @id @default(cuid())
  key            String         @unique
  description    String?
  enabled        Boolean        @default(false)
  rolloutPercent Int            @default(100)
  rules          Json?          // Scope target: e.g., {"organizations":["org_cuid"],"industries":["journalism"]}
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model SystemMetric {
  id             String         @id @default(cuid())
  timestamp      DateTime       @default(now())
  metricType     String         // CPU, MEMORY, API_THROUGHPUT, AI_LATENCY, STORAGE_USAGE
  value          Float
  dimensions     Json?          // Extra context: e.g., {"endpoint": "/api/ai/chat"}
}

model TenantSetting {
  id             String         @id @default(cuid())
  orgId          String         @unique
  industry       String         @default("CYBERSECURITY") // JOURNALISM, ACADEMIC, LEGAL, GOVERNMENT, ENTERPRISE
  locale         String         @default("en-US")
  timezone       String         @default("UTC")
  retentionDays  Int            @default(365)
  featuresConfig Json?          // Specific configuration toggles
  updatedAt      DateTime       @updatedAt
}

