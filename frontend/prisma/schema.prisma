// Veridex Forensics — Prisma Database Schema
// Digital Trust Operating System Data Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTHENTICATION MODELS
// ==========================================

enum UserRole {
  GUEST
  FREE
  STUDENT
  RESEARCHER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  ADMINISTRATOR
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
  ACADEMIC
}

model User {
  id                    String             @id @default(cuid())
  name                  String?
  email                 String             @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  role                  UserRole           @default(FREE)
  subscriptionTier      SubscriptionTier   @default(FREE)
  referralCode          String             @unique @default(cuid())
  referredByCode        String?
  organizationId        String?
  createdDate           DateTime           @default(now())
  lastLogin             DateTime           @default(now())
  
  // JSON Preferences & Notifications
  preferences           Json?              @default("{\"theme\":\"dark\",\"defaultModality\":\"text\",\"autoExportPdf\":false}")
  notificationSettings  Json?              @default("{\"emailAlerts\":true,\"creditWarnings\":true,\"weeklyReport\":false}")
  onboardingCompleted   Boolean            @default(false)
  useCase               String?            // Journalist, HR, University, Research, Law, Enterprise

  // Relationships
  accounts              Account[]
  sessions              Session[]
  organization          Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creditBalance         CreditBalance?
  creditTransactions    CreditTransaction[]
  cases                 Case[]
  evidenceItems         Evidence[]
  reports               Report[]
  apiKeys               APIKey[]
  activityLogs          ActivityLog[]
  subscriptions         Subscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// CREDIT ECONOMY MODELS
// ==========================================

model CreditBalance {
  id                String   @id @default(cuid())
  userId            String   @unique
  monthlyAllocation Int      @default(50)
  creditsRemaining  Int      @default(50)
  creditsUsed       Int      @default(0)
  bonusCredits      Int      @default(0)
  lastResetDate     DateTime @default(now())
  nextResetDate     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  action       String   // TEXT_AUDIT, IMAGE_FORENSIC, PDF_SCAN, AUDIO_AUDIT, VIDEO_VERIFY, URL_AUDIT, METADATA_SCAN, REPLENISHMENT, PURCHASE
  creditsUsed  Int
  remaining    Int
  timestamp    DateTime @default(now())
  caseId       String?
  reportId     String?
  ipAddress    String?
  deviceInfo   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditRateCard {
  id          String   @id @default(cuid())
  modality    String   @unique // text, image, pdf, audio, video, link, metadata
  creditCost  Int
  description String
  updatedAt   DateTime @updatedAt
}

// ==========================================
// ENTERPRISE & ORGANIZATION MODELS
// ==========================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  ssoEnabled  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     User[]
  departments Department[]
  cases       Case[]
  apiKeys     APIKey[]
}

model Department {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==========================================
// FORENSIC DATA MODELS (CASES, EVIDENCE, REPORTS)
// ==========================================

model Case {
  id             String        @id @default(cuid())
  caseNumber     String        @unique
  title          String
  description    String?
  status         String        @default("OPEN") // OPEN, IN_REVIEW, CLOSED, ARCHIVED
  priority       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  userId         String
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  evidence     Evidence[]
  reports      Report[]
}

model Evidence {
  id            String   @id @default(cuid())
  title         String
  modality      String   // text, image, audio, video, pdf, url
  fileHash      String   // SHA-256 cryptographic hash
  storageUrl    String?
  fileSizeBytes Int?
  caseId        String?
  userId        String
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case    Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  reports Report[]
}

model Report {
  id           String   @id @default(cuid())
  title        String
  verityIndex  Float
  truthScore   Float
  confidence   Float
  origin       String   // ai, human, hybrid
  findings     Json     // Array of evidence findings
  biasReport   Json?
  factuality   Json?
  spectral     Json?
  evidenceId   String?
  caseId       String?
  userId       String
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  case     Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
}

// ==========================================
// BILLING, API KEYS & SECURITY AUDIT LOGS
// ==========================================

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  status               String   // active, canceled, past_due, trialing
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model APIKey {
  id             String        @id @default(cuid())
  keyHash        String        @unique
  prefix         String
  name           String
  userId         String
  organizationId String?
  rateLimit      Int           @default(1000)
  createdAt      DateTime      @default(now())
  lastUsed       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
